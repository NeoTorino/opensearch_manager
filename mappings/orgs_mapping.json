{
  "settings": {
    "number_of_shards": 1,
    "number_of_replicas": 0,
    "default_pipeline": "normalize_dates_pipeline"
  },
  "mappings": {
    "dynamic": "strict",
    "properties": {
      "active": {
        "type": "boolean",
        "null_value": true
      },
      "careers_url": {
        "type": "keyword"
      },
      "country": {
        "type": "keyword"
      },
      "country_code": {
        "type": "keyword"
      },
      "created": {
        "type": "date",
        "format": "yyyy-MM-dd"
      },
      "description": {
        "type": "text"
      },
      "excluded": {
        "type": "boolean",
        "null_value": false
      },
      "jobs_posted": {
        "type": "integer"
      },
      "last_scraped_at": {
        "type": "date",
        "format": "yyyy-MM-dd"
      },
      "name": {
        "type": "text",
        "fields": {
          "keyword": {
            "type": "keyword"
          }
        }
      },
      "scrape_url": {
        "type": "keyword"
      },
      "source": {
        "type": "keyword"
      },
      "updated_at": {
        "type": "date",
        "format": "yyyy-MM-dd"
      },
      "url": {
        "type": "keyword"
      }
    }
  }
}